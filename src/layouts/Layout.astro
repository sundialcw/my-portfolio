---
// src/layouts/Layout.astro
interface Props {
  title?: string;
  activeNav?: 'reel' | 'about' | 'contact';
}

const { title = "Sundial Color Works", activeNav = 'reel' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  
  <!-- Google Fonts: Faculty Glyphic (Main/Brand) + IBM Plex Mono (Nav) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Faculty+Glyphic&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
</head>
<body>

  <!-- GLOBAL HEADER -->
  <header class="site-header">
    <a href="/" class="brand-link">
      <!-- Eguzkilore Flower SVG Motif -->
      <svg class="logo-icon" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <circle cx="50" cy="50" r="14" stroke="currentColor" stroke-width="2.5" />
        <circle cx="50" cy="50" r="6" stroke="currentColor" stroke-width="1.5" />
        <g stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="50" y1="8" x2="50" y2="28" />
          <line x1="50" y1="72" x2="50" y2="92" />
          <line x1="8" y1="50" x2="28" y2="50" />
          <line x1="72" y1="50" x2="92" y2="50" />
          <line x1="20" y1="20" x2="34" y2="34" />
          <line x1="66" y1="66" x2="80" y2="80" />
          <line x1="20" y1="80" x2="34" y2="66" />
          <line x1="66" y1="34" x2="80" y2="20" />
        </g>
      </svg>
      <span class="brand-name">Sundial Color Works</span>
    </a>

    <!-- TOP RIGHT NAVIGATION -->
    <nav class="site-nav" aria-label="Main Navigation">
      <a href="/" class={activeNav === 'reel' ? 'nav-link active' : 'nav-link'}>reel</a>
      <a href="/about" class={activeNav === 'about' ? 'nav-link active' : 'nav-link'}>about</a>
      <a href="/contact" class={activeNav === 'contact' ? 'nav-link active' : 'nav-link'}>contact</a>
    </nav>
  </header>

  <!-- MAIN PAGE CONTENT -->
  <main>
    <slot />
  </main>

  <!-- GLOBAL FOOTER -->
  <footer class="site-footer">
    <div class="footer-socials">
      <!-- Instagram (Solid/Chunky) -->
      <a 
        href="https://instagram.com/YOUR_HANDLE" 
        target="_blank" 
        rel="noopener noreferrer" 
        aria-label="Instagram"
        class="social-link"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" class="social-icon">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
        </svg>
      </a>

      <!-- LinkedIn (Solid/Chunky) -->
      <a 
        href="https://linkedin.com/in/YOUR_HANDLE" 
        target="_blank" 
        rel="noopener noreferrer" 
        aria-label="LinkedIn"
        class="social-link"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" class="social-icon">
          <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
        </svg>
      </a>
    </div>
  </footer>

</body>
</html>

<style is:global>
  :root {
    --font-primary: 'Faculty Glyphic', sans-serif;
    --font-mono: 'IBM Plex Mono', monospace;
    --bg-color: #050508;
    --text-color: #f0f0f5;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family: var(--font-primary);
    background-color: var(--bg-color);
    color: var(--text-color);
    min-height: 100vh;
    padding: 1.5rem;
    font-size: 1.05rem;
    line-height: 1.6;

    /* FLEX LAYOUT TO KEEP FOOTER AT BOTTOM */
    display: flex;
    flex-direction: column;

    /* ORGANIC CLUSTERED STARFIELD BACKGROUND */
    background-image: 
      radial-gradient(3px 3px at 40px 80px, #ffffff, rgba(255,255,255,0.3) 60%, transparent),
      radial-gradient(1.5px 1.5px at 45px 85px, #ffffff, transparent),
      radial-gradient(1.5px 1.5px at 42px 75px, rgba(255,255,255,0.9), transparent),
      radial-gradient(4px 4px at 280px 420px, #ffffff, rgba(255,255,255,0.4) 50%, transparent),
      radial-gradient(2px 2px at 510px 180px, #ffffff, transparent),
      radial-gradient(1.2px 1.2px at 110px 230px, #ffffff, transparent),
      radial-gradient(1px 1px at 115px 238px, rgba(255,255,255,0.8), transparent),
      radial-gradient(2.5px 2.5px at 320px 110px, #ffffff, rgba(255,255,255,0.3) 50%, transparent),
      radial-gradient(1.2px 1.2px at 410px 390px, rgba(255,255,255,0.85), transparent),
      radial-gradient(1px 1px at 20px 40px, rgba(255,255,255,0.6), transparent),
      radial-gradient(1px 1px at 90px 190px, rgba(255,255,255,0.5), transparent),
      radial-gradient(1.5px 1.5px at 210px 70px, rgba(255,255,255,0.7), transparent),
      radial-gradient(1px 1px at 270px 250px, rgba(255,255,255,0.6), transparent);

    background-repeat: repeat;
    background-size: 600px 600px, 470px 470px, 310px 310px;
  }

  main {
    flex: 1;
  }

  /* HEADER & NAV STYLES */
  .site-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto 3rem auto;
    width: 100%;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    color: var(--text-color);
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .brand-link:hover {
    opacity: 0.8;
  }

  .logo-icon {
    width: 30px;
    height: 30px;
    flex-shrink: 0;
  }

  .brand-name {
    font-family: var(--font-primary) !important;
    font-size: 1.35rem;
    font-weight: 400;
    letter-spacing: 0.03em;
    text-transform: none;
  }

  .site-nav {
    display: flex;
    gap: 1.75rem;
  }

  .nav-link {
    font-family: var(--font-mono);
    color: rgba(255, 255, 255, 0.55);
    text-decoration: none;
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    text-transform: lowercase;
    transition: color 0.2s ease;
  }

  .nav-link:hover,
  .nav-link.active {
    color: #ffffff;
  }

  .nav-link.active {
    border-bottom: 1px solid #ffffff;
    padding-bottom: 2px;
  }

  /* GLOBAL FOOTER STYLES */
  .site-footer {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 4rem 0 2rem 0;
  }

  .footer-socials {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2rem;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.55);
    text-decoration: none;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .social-link:hover {
    color: #ffffff;
    transform: translateY(-2px);
  }

  .social-icon {
    display: block;
    width: 22px;
    height: 22px;
  }

  @media (max-width: 600px) {
    .site-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
    }
  }
</style>
