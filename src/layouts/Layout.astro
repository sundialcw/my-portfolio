---
// src/layouts/Layout.astro
interface Props {
  title?: string;
  activeNav?: 'reel' | 'about' | 'contact';
}

const { title = "Sundial Color Works", activeNav = 'reel' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  
  <!-- IBM Plex Mono Font -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body>

  <!-- GLOBAL HEADER -->
  <header class="site-header">
    <a href="/" class="brand-link">
      <!-- Eguzkilore Flower SVG Placeholder -->
      <svg class="logo-icon" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <circle cx="50" cy="50" r="16" stroke="currentColor" stroke-width="3" />
        <!-- Radiating Petals / Sun Rays -->
        <g stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <line x1="50" y1="8" x2="50" y2="26" />
          <line x1="50" y1="74" x2="50" y2="92" />
          <line x1="8" y1="50" x2="26" y2="50" />
          <line x1="74" y1="50" x2="92" y2="50" />
          <line x1="20" y1="20" x2="33" y2="33" />
          <line x1="67" y1="67" x2="80" y2="80" />
          <line x1="20" y1="80" x2="33" y2="67" />
          <line x1="67" y1="33" x2="80" y2="20" />
        </g>
      </svg>
      <span class="brand-name">Sundial Color Works</span>
    </a>

    <!-- TOP RIGHT NAVIGATION -->
    <nav class="site-nav" aria-label="Main Navigation">
      <a href="/" class={activeNav === 'reel' ? 'nav-link active' : 'nav-link'}>Reel</a>
      <a href="/about" class={activeNav === 'about' ? 'nav-link active' : 'nav-link'}>About</a>
      <a href="/contact" class={activeNav === 'contact' ? 'nav-link active' : 'nav-link'}>Contact</a>
    </nav>
  </header>

  <!-- MAIN PAGE CONTENT -->
  <main>
    <slot />
  </main>

</body>
</html>

<style is:global>
  :root {
    --font-mono: 'IBM Plex Mono', monospace;
    --bg-color: #050508;
    --text-color: #f0f0f5;
    --accent-hover: rgba(255, 255, 255, 0.75);
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

body {
  font-family: var(--font-mono);
  background-color: var(--bg-color);
  color: var(--text-color);
  min-height: 100vh;
  padding: 1.5rem;

  /* ENHANCED B&W STARFIELD */
  background-image: 
    /* Small pinprick stars */
    radial-gradient(1px 1px at 25px 35px, rgba(255, 255, 255, 0.9), rgba(0,0,0,0)),
    radial-gradient(1px 1px at 85px 120px, rgba(255, 255, 255, 0.7), rgba(0,0,0,0)),
    radial-gradient(1px 1px at 180px 45px, rgba(255, 255, 255, 0.8), rgba(0,0,0,0)),
    radial-gradient(1.2px 1.2px at 240px 190px, rgba(255, 255, 255, 0.85), rgba(0,0,0,0)),
    radial-gradient(1px 1px at 340px 95px, rgba(255, 255, 255, 0.75), rgba(0,0,0,0)),
    radial-gradient(1px 1px at 410px 220px, rgba(255, 255, 255, 0.9), rgba(0,0,0,0)),
    radial-gradient(1.2px 1.2px at 470px 60px, rgba(255, 255, 255, 0.8), rgba(0,0,0,0)),

    /* Medium stars */
    radial-gradient(2px 2px at 50px 160px, #ffffff, rgba(0,0,0,0)),
    radial-gradient(2px 2px at 150px 230px, #ffffff, rgba(0,0,0,0)),
    radial-gradient(2px 2px at 290px 140px, #ffffff, rgba(0,0,0,0)),
    radial-gradient(2.5px 2.5px at 390px 280px, #ffffff, rgba(0,0,0,0)),

    /* Large foreground stars with soft light halo */
    radial-gradient(3.5px 3.5px at 110px 70px, #ffffff, rgba(255,255,255,0.4) 50%, rgba(0,0,0,0)),
    radial-gradient(4px 4px at 310px 210px, #ffffff, rgba(255,255,255,0.3) 50%, rgba(0,0,0,0)),
    radial-gradient(3px 3px at 450px 130px, #ffffff, rgba(255,255,255,0.4) 50%, rgba(0,0,0,0));

  background-repeat: repeat;
  /* Reduced tile size from 550px to 480px increases repeat frequency/density */
  background-size: 480px 320px; 
}

  /* HEADER & NAV STYLES */
  .site-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto 3rem auto;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--text-color);
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .brand-link:hover {
    opacity: 0.8;
  }

  .logo-icon {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
  }

  .brand-name {
    font-size: 1.1rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .site-nav {
    display: flex;
    gap: 1.5rem;
  }

  .nav-link {
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
    font-size: 0.9rem;
    letter-spacing: 0.05em;
    text-transform: lowercase;
    transition: color 0.2s ease;
  }

  .nav-link:hover,
  .nav-link.active {
    color: #ffffff;
  }

  .nav-link.active {
    border-bottom: 1px solid #ffffff;
    padding-bottom: 2px;
  }

  @media (max-width: 600px) {
    .site-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
  }
</style>
