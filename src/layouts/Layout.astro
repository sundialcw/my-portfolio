---
// src/layouts/Layout.astro
interface Props {
  title?: string;
  activeNav?: 'reel' | 'about' | 'contact';
}

const { title = "Sundial Color Works", activeNav = 'reel' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  
  <!-- Google Fonts: Space Grotesk (Brand Title) + IBM Plex Mono (Nav & Body) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Space+Grotesk:wght@500;600&display=swap" rel="stylesheet">
</head>
<body>

  <!-- GLOBAL HEADER -->
  <header class="site-header">
    <a href="/" class="brand-link">
      <!-- Eguzkilore Flower SVG Motif -->
      <svg class="logo-icon" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <circle cx="50" cy="50" r="14" stroke="currentColor" stroke-width="2.5" />
        <circle cx="50" cy="50" r="6" stroke="currentColor" stroke-width="1.5" />
        <g stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="50" y1="8" x2="50" y2="28" />
          <line x1="50" y1="72" x2="50" y2="92" />
          <line x1="8" y1="50" x2="28" y2="50" />
          <line x1="72" y1="50" x2="92" y2="50" />
          <line x1="20" y1="20" x2="34" y2="34" />
          <line x1="66" y1="66" x2="80" y2="80" />
          <line x1="20" y1="80" x2="34" y2="66" />
          <line x1="66" y1="34" x2="80" y2="20" />
        </g>
      </svg>
      <span class="brand-name">Sundial Color Works</span>
    </a>

    <!-- TOP RIGHT NAVIGATION -->
    <nav class="site-nav" aria-label="Main Navigation">
      <a href="/" class={activeNav === 'reel' ? 'nav-link active' : 'nav-link'}>reel</a>
      <a href="/about" class={activeNav === 'about' ? 'nav-link active' : 'nav-link'}>about</a>
      <a href="/contact" class={activeNav === 'contact' ? 'nav-link active' : 'nav-link'}>contact</a>
    </nav>
  </header>

  <!-- MAIN PAGE CONTENT -->
  <main>
    <slot />
  </main>

</body>
</html>

<style is:global>
  :root {
    --font-mono: 'IBM Plex Mono', monospace;
    --font-sans: 'Space Grotesk', sans-serif;
    --bg-color: #050508;
    --text-color: #f0f0f5;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family: var(--font-mono);
    background-color: var(--bg-color);
    color: var(--text-color);
    min-height: 100vh;
    padding: 1.5rem;

    /* ORGANIC CLUSTERED STARFIELD BACKGROUND */
    background-image: 
      radial-gradient(3px 3px at 40px 80px, #ffffff, rgba(255,255,255,0.3) 60%, transparent),
      radial-gradient(1.5px 1.5px at 45px 85px, #ffffff, transparent),
      radial-gradient(1.5px 1.5px at 42px 75px, rgba(255,255,255,0.9), transparent),
      radial-gradient(4px 4px at 280px 420px, #ffffff, rgba(255,255,255,0.4) 50%, transparent),
      radial-gradient(2px 2px at 510px 180px, #ffffff, transparent),
      radial-gradient(1.2px 1.2px at 110px 230px, #ffffff, transparent),
      radial-gradient(1px 1px at 115px 238px, rgba(255,255,255,0.8), transparent),
      radial-gradient(2.5px 2.5px at 320px 110px, #ffffff, rgba(255,255,255,0.3) 50%, transparent),
      radial-gradient(1.2px 1.2px at 410px 390px, rgba(255,255,255,0.85), transparent),
      radial-gradient(1px 1px at 20px 40px, rgba(255,255,255,0.6), transparent),
      radial-gradient(1px 1px at 90px 190px, rgba(255,255,255,0.5), transparent),
      radial-gradient(1.5px 1.5px at 210px 70px, rgba(255,255,255,0.7), transparent),
      radial-gradient(1px 1px at 270px 250px, rgba(255,255,255,0.6), transparent);

    background-repeat: repeat;
    background-size: 600px 600px, 470px 470px, 310px 310px;
  }

  /* HEADER & NAV STYLES */
  .site-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto 3rem auto;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    color: var(--text-color);
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .brand-link:hover {
    opacity: 0.8;
  }

  .logo-icon {
    width: 30px;
    height: 30px;
    flex-shrink: 0;
  }

  .brand-name {
    font-family: var(--font-sans) !important;
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: none; /* Keeps it in standard title case */
  }

  .site-nav {
    display: flex;
    gap: 1.75rem;
  }

  .nav-link {
    font-family: var(--font-mono);
    color: rgba(255, 255, 255, 0.55);
    text-decoration: none;
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    text-transform: lowercase;
    transition: color 0.2s ease;
  }

  .nav-link:hover,
  .nav-link.active {
    color: #ffffff;
  }

  .nav-link.active {
    border-bottom: 1px solid #ffffff;
    padding-bottom: 2px;
  }

  @media (max-width: 600px) {
    .site-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
    }
  }
</style>
