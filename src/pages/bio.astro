---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Bio" active="bio">
  <section class="bio">
    <p class="eyebrow">No. 001 — Bio</p>
    <h1>Your Name</h1>
    <p class="lede">
      A short line establishing who you are and the kind of color work you do —
      film, commercial, narrative, music video, whatever fits.
    </p>
    <div class="body">
      <p>
        Replace this with your actual bio copy. Talk about your background,
        your approach to color, tools you work in, and the kinds of projects
        or collaborators you're drawn to.
      </p>
      <p>
        A second paragraph can cover career highlights, notable clients,
        or the philosophy behind your work.
      </p>
    </div>
  </section>

  <style>
    .bio {
      max-width: 640px;
      margin: 0 auto;
      padding: clamp(40px, 8vw, 90px) 24px 120px;
    }

    .eyebrow {
      font-family: var(--font-mono);
      font-size: 12px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--muted);
      margin: 0 0 20px;
    }

    h1 {
      font-family: var(--font-display);
      font-weight: 300;
      font-size: clamp(36px, 6vw, 56px);
      margin: 0 0 20px;
    }

    .lede {
      font-family: var(--font-display);
      font-style: italic;
      font-size: clamp(18px, 2vw, 22px);
      color: var(--ink);
      opacity: 0.9;
      margin: 0 0 40px;
      border-left: 1px solid var(--hairline);
      padding-left: 20px;
    }

    .body p {
      font-size: 16px;
      line-height: 1.7;
      color: var(--muted);
      margin: 0 0 20px;
    }
  </style>
</Layout>
