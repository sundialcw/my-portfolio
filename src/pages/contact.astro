---
// src/pages/contact.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact — Sundial Color Works" activeNav="contact">
  <section class="content-container">
    <h1 class="page-title">Contact</h1>
    
    <div class="contact-card">
      <p class="intro-lead">
        For project inquiries, availability, or general questions, reach out directly below:
      </p>

      <div class="contact-details">
        <div class="detail-group">
          <span class="label">General Inquiries</span>
          <a href="mailto:hello@sundialcolor.com" class="contact-link">hello@sundialcolor.com</a>
        </div>

        <div class="detail-group">
          <span class="label">Studio Location</span>
          <p class="detail-value">New York, NY</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .content-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem 0;
  }

  .page-title {
    font-size: 2rem;
    font-weight: 400;
    margin-bottom: 2.5rem;
    letter-spacing: 0.02em;
  }

  .intro-lead {
    font-size: 1.2rem;
    line-height: 1.6;
    margin-bottom: 3rem;
    color: rgba(255, 255, 255, 0.9);
  }

  .contact-details {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .detail-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .label {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-transform: lowercase;
    color: rgba(255, 255, 255, 0.5);
    letter-spacing: 0.05em;
  }

  .contact-link,
  .detail-value {
    font-size: 1.25rem;
    color: var(--text-color);
    text-decoration: none;
  }

  .contact-link {
    border-bottom: 1px solid rgba(255, 255, 255, 0.3);
    width: fit-content;
    padding-bottom: 2px;
    transition: border-color 0.2s ease;
  }

  .contact-link:hover {
    border-color: #ffffff;
  }
</style>
