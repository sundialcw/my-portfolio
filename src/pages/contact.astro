---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contact" active="contact">
  <section class="contact">
    <p class="eyebrow">No. 002 — Contact</p>
    <h1>Get in touch</h1>
    <ul class="links">
      <li>
        <span class="label">Email</span>
        <a href="mailto:you@sundialcolorworks.com">you@sundialcolorworks.com</a>
      </li>
      <li>
        <span class="label">Instagram</span>
        <a href="https://instagram.com/yourhandle" target="_blank" rel="noopener">@yourhandle</a>
      </li>
      <li>
        <span class="label">Vimeo</span>
        <a href="https://vimeo.com/yourhandle" target="_blank" rel="noopener">vimeo.com/yourhandle</a>
      </li>
    </ul>
  </section>

  <style>
    .contact {
      max-width: 640px;
      margin: 0 auto;
      padding: clamp(40px, 8vw, 90px) 24px 120px;
    }

    .eyebrow {
      font-family: var(--font-mono);
      font-size: 12px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--muted);
      margin: 0 0 20px;
    }

    h1 {
      font-family: var(--font-display);
      font-weight: 300;
      font-size: clamp(36px, 6vw, 56px);
      margin: 0 0 48px;
    }

    .links {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .links li {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      padding: 18px 0;
      border-top: 1px solid var(--hairline);
    }

    .links li:last-child {
      border-bottom: 1px solid var(--hairline);
    }

    .label {
      font-family: var(--font-mono);
      font-size: 12px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--muted);
    }

    .links a {
      font-family: var(--font-display);
      font-size: 19px;
      color: var(--ink);
      text-decoration: none;
      border-bottom: 1px solid transparent;
      transition: border-color 0.2s ease;
    }

    .links a:hover {
      border-bottom-color: var(--ink);
    }
  </style>
</Layout>
