---
// src/pages/about.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="About — Sundial Color Works" activeNav="about">
  <section class="content-container">
    <h1 class="page-title">About</h1>
    
    <div class="bio-text">
      <p>
        Sundial Color Works is the independent grading studio of Ashley Ayarza Woods.
      </p>
      
      <div class="bio-photo">
        <img src="/Seeds2.jpg" alt="Ashley Ayarza Woods" />
      </div>

      <p>
        Based in Jersey City, I approach color with a poetic sensibility, balancing harmony with tension, and depth with restraint. Some pieces call for subtle refinements, while others require bold shifts. In every case, I grade thoughtfully to deepen the viewer’s connection to the work and elevate their visual experience.
      </p>
      <p>
        Beyond pure aestheticism, my process is grounded in analytical thinking and logical troubleshooting. Whether designing custom workflows, or stepping in to a team’s pre-established pipeline, I offer a calm and flexible solutions-oriented partnership.
      </p>
      <p>
        I operate remote-first with options for virtual collaboration, and am also available for on-site work throughout the tri-state area and beyond.
      </p>
    </div>
  </section>
</Layout>

<style>
  .content-container {
    max-width: 1200px; /* Increased from 900px so it spans wider across desktop */
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }

  .page-title {
    font-size: 2rem;
    font-weight: 400;
    margin-bottom: 2.5rem;
    letter-spacing: 0.02em;
    text-align: center; /* Centered to match your text */
  }

  .bio-text {
    max-width: 1000px; /* Controls how wide the text block expands */
    margin: 0 auto;
    text-align: center;
  }

  .bio-text p {
    text-align: center;
    margin-bottom: 2rem;
  }

  .bio-photo {
  display: block;
  margin: 3rem auto;
  text-align: center; /* Ensures smaller images stay centered */
}

.bio-photo img {
  display: inline-block;
  max-width: 100%;    /* Prevents overflowing small screens */
  width: auto;        /* Preserves intrinsic size up to max-width */
  height: auto;
  margin: 0 auto;
}
</style>