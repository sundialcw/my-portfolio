---
// src/pages/about.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="About — Sundial Color Works" activeNav="about">
  <section class="content-container">
    <h1 class="page-title">About</h1>

    <div class="bio-photo">
      <img src="/Seeds2.jpg" alt="Ashley Ayarza Woods" />
    </div>

    <div class="bio-text">
      <p>
        Sundial Color Works is the independent grading studio of Ashley Ayarza Woods.
      </p>
      <p>
        Based in Jersey City, I approach color with a poetic sensibility, balancing harmony with tension, and depth with restraint. Some pieces call for subtle refinements, while others require bold shifts. In every case, I grade thoughtfully to deepen the viewer’s connection to the work and elevate their visual experience.
      </p>
      <p>
        Beyond pure aestheticism, my process is grounded in analytical thinking and logical troubleshooting. Whether designing custom workflows, or stepping in to a team’s pre-established pipeline, I offer a calm and flexible solutions-oriented partnership.
      </p>
      <p>
        I operate remote-first with options for virtual collaboration, and am also available for on-site work throughout the tri-state area and beyond.
      </p>
    </div>

    <div class="socials-block">
      <h2>Connect</h2>
      <ul>
        <li><a href="https://instagram.com/YOUR_HANDLE" target="_blank" rel="noopener noreferrer">Instagram</a></li>
        <li><a href="https://linkedin.com/in/YOUR_HANDLE" target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
      </ul>
    </div>
  </section>
</Layout>

<style>
  .content-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem 0;
  }

  .page-title {
    font-size: 2rem;
    font-weight: 400;
    margin-bottom: 2.5rem;
    letter-spacing: 0.02em;
  }

  .bio-photo {
    display: block;
    margin-bottom: 3rem;
  }

  .bio-photo img {
    display: block;
    max-width: 100%;
    width: auto;
    height: auto;
  }

  .bio-text p {
    font-size: 1.1rem;
    line-height: 1.7;
    margin-bottom: 2rem;
    color: rgba(255, 255, 255, 0.9);
  }

  /* Socials styling matching capabilities typography */
  .socials-block {
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1); /* Subtle divider line */
  }

  .socials-block h2 {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 400;
    text-transform: lowercase;
    letter-spacing: 0.05em;
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: 1rem;
  }

  .socials-block ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: 1.75rem;
  }

  .socials-block a {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    padding-bottom: 2px;
    transition: all 0.2s ease;
  }

  .socials-block a:hover {
    color: #ffffff;
    border-color: #ffffff;
  }
</style>
