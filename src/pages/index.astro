---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';

const BUNNY_LIBRARY_ID = "706205";

const videoItems = [
  {
    title: "Commercial Reel",
    thumbnail: "https://images.unsplash.com/photo-1536240478700-b869070f9279?auto=format&fit=crop&w=800&q=80",
    bunnyVideoId: "ab0201e5-7f5a-45ce-9cc9-1b8f2af4034b" // <-- Your first Bunny Stream video
  },
  {
    title: "Feature Film Grade",
    thumbnail: "https://images.unsplash.com/photo-1485846234645-a62644f84728?auto=format&fit=crop&w=800&q=80",
    bunnyVideoId: "ab0201e5-7f5a-45ce-9cc9-1b8f2af4034b" // <-- Replace with next Bunny Video ID
  },
  {
    title: "Music Video Pass",
    thumbnail: "https://images.unsplash.com/photo-1518173946687-a4c8a383392e?auto=format&fit=crop&w=800&q=80",
    bunnyVideoId: "ab0201e5-7f5a-45ce-9cc9-1b8f2af4034b" // <-- Replace with next Bunny Video ID
  },
  {
    title: "Documentary Color",
    thumbnail: "https://images.unsplash.com/photo-1574717024653-61fd2cf4d44d?auto=format&fit=crop&w=800&q=80",
    bunnyVideoId: "ab0201e5-7f5a-45ce-9cc9-1b8f2af4034b" // <-- Replace with next Bunny Video ID
  },
  {
    title: "Short Film Pass",
    thumbnail: "https://images.unsplash.com/photo-1492691527719-9d1e07e534b4?auto=format&fit=crop&w=800&q=80",
    bunnyVideoId: "ab0201e5-7f5a-45ce-9cc9-1b8f2af4034b" // <-- Replace with next Bunny Video ID
  },
  {
    title: "Editorial Campaign",
    thumbnail: "https://images.unsplash.com/photo-1500462828032-59601d932620?auto=format&fit=crop&w=800&q=80",
    bunnyVideoId: "ab0201e5-7f5a-45ce-9cc9-1b8f2af4034b" // <-- Replace with next Bunny Video ID
  }
];
---

<Layout title="Sundial Color Works — Reel" activeNav="reel">
  <div class="container">
    <!-- 16:9 Thumbnail Grid -->
    <div class="portfolio-grid">
      {videoItems.map((item) => (
        <button 
          class="thumbnail-card" 
          data-bunny-id={item.bunnyVideoId}
          data-library-id={BUNNY_LIBRARY_ID}
          aria-label={`Play ${item.title}`}
        >
          <div class="aspect-ratio-box">
            <img src={item.thumbnail} alt={item.title} loading="lazy" />
            <div class="overlay">
              <span class="video-title">{item.title}</span>
            </div>
          </div>
        </button>
      ))}
    </div>
  </div>

  <!-- Lightbox Modal -->
  <div id="lightbox" class="lightbox" aria-hidden="true">
    <div class="lightbox-overlay" id="lightbox-backdrop"></div>
    <div class="lightbox-content">
      <button id="close-btn" class="close-btn" aria-label="Close modal">&times;</button>
      <div class="video-wrapper">
        <iframe
          id="lightbox-player"
          src=""
          loading="lazy"
          allow="accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture; fullscreen;"
          allowfullscreen="true"
        ></iframe>
      </div>
    </div>
  </div>
</Layout>

<script>
  const lightbox = document.getElementById('lightbox');
  const lightboxPlayer = document.getElementById('lightbox-player') as HTMLIFrameElement;
  const closeBtn = document.getElementById('close-btn');
  const backdrop = document.getElementById('lightbox-backdrop');
  const cards = document.querySelectorAll('.thumbnail-card');

  function openLightbox(libraryId: string, videoId: string) {
    if (!lightbox || !lightboxPlayer) return;
    // Builds the Bunny Stream embed URL with autoplay enabled when clicked
    lightboxPlayer.src = `https://player.mediadelivery.net/embed/${libraryId}/${videoId}?autoplay=true&loop=false&muted=false&preload=true&responsive=true`;
    lightbox.classList.add('active');
    lightbox.setAttribute('aria-hidden', 'false');
  }

  function closeLightbox() {
    if (!lightbox || !lightboxPlayer) return;
    // Clearing src stops the video and audio immediately on close
    lightboxPlayer.src = '';
    lightbox.classList.remove('active');
    lightbox.setAttribute('aria-hidden', 'true');
  }

  cards.forEach(card => {
    card.addEventListener('click', () => {
      const libraryId = card.getAttribute('data-library-id');
      const videoId = card.getAttribute('data-bunny-id');
      if (libraryId && videoId) {
        openLightbox(libraryId, videoId);
      }
    });
  });

  closeBtn?.addEventListener('click', closeLightbox);
  backdrop?.addEventListener('click', closeLightbox);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && lightbox?.classList.contains('active')) {
      closeLightbox();
    }
  });
</script>

<style>
  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .portfolio-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);