---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';

const videoItems = [
  {
    title: "Project Alpha - Commercial",
    thumbnail: "https://images.unsplash.com/photo-1536240478700-b869070f9279?auto=format&fit=crop&w=800&q=80",
    videoSrc: "https://www.w3schools.com/html/mov_bbb.mp4"
  },
  {
    title: "Project Beta - Short Film",
    thumbnail: "https://images.unsplash.com/photo-1485846234645-a62644f84728?auto=format&fit=crop&w=800&q=80",
    videoSrc: "https://www.w3schools.com/html/mov_bbb.mp4"
  }
];
---

<Layout title="Portfolio">
  <main class="container">
    <header class="header">
      <h1>PORTFOLIO</h1>
    </header>

    <div class="portfolio-grid">
      {videoItems.map((item) => (
        <button 
          class="thumbnail-card" 
          data-video-src={item.videoSrc}
          aria-label={`Play ${item.title}`}
        >
          <div class="aspect-ratio-box">
            <img src={item.thumbnail} alt={item.title} loading="lazy" />
            <div class="overlay">
              <span class="video-title">{item.title}</span>
            </div>
          </div>
        </button>
      ))}
    </div>
  </main>

  <div id="lightbox" class="lightbox" aria-hidden="true">
    <div class="lightbox-overlay" id="lightbox-backdrop"></div>
    <div class="lightbox-content">
      <button id="close-btn" class="close-btn" aria-label="Close modal">&times;</button>
      <div class="video-wrapper">
        <video id="lightbox-player" controls playsinline>
          <source src="" type="video/mp4" />
        </video>
      </div>
    </div>
  </div>
</Layout>

<script>
  const lightbox = document.getElementById('lightbox');
  const lightboxPlayer = document.getElementById('lightbox-player') as HTMLVideoElement;
  const closeBtn = document.getElementById('close-btn');
  const backdrop = document.getElementById('lightbox-backdrop');
  const cards = document.querySelectorAll('.thumbnail-card');

  function openLightbox(src: string) {
    if (!lightbox || !lightboxPlayer) return;
    lightboxPlayer.src = src;
    lightbox.classList.add('active');
    lightbox.setAttribute('aria-hidden', 'false');
    lightboxPlayer.play();
  }

  function closeLightbox() {
    if (!lightbox || !lightboxPlayer) return;
    lightboxPlayer.pause();
    lightboxPlayer.src = '';
    lightbox.classList.remove('active');
    lightbox.setAttribute('aria-hidden', 'true');
  }

  cards.forEach(card => {
    card.addEventListener('click', () => {
      const src = card.getAttribute('data-video-src');
      if (src) openLightbox(src);
    });
  });

  closeBtn?.addEventListener('click', closeLightbox);
  backdrop?.addEventListener('click', closeLightbox);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && lightbox?.classList.contains('active')) {
      closeLightbox();
    }
  });
</script>

<style>
  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .header {
    margin-bottom: 2.5rem;
    text-align: center;
    letter-spacing: 0.1em;
  }

  .header h1 {
    font-size: 1.75rem;
    font-weight: 500;
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
    display: inline-block;
    padding-bottom: 0.5rem;
  }

  .portfolio-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .portfolio-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .portfolio-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .thumbnail-card {
    background: none;
    border: 1px solid rgba(255, 255, 255, 0.1);
    cursor: pointer;
    padding: 0;
    overflow: hidden;
    outline: none;
    transition: border-color 0.2s ease, transform 0.2s ease;
    width: 100%;
  }

  .thumbnail-card:hover,
  .thumbnail-card:focus-visible {
    border-color: rgba(255, 255, 255, 0.6);
    transform: translateY(-2px);
  }

  .aspect-ratio-box {
    position: relative;
    width: 100%;
    padding-top: 56.25%;
  }

  .aspect-ratio-box img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.75);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.25s ease;
    padding: 1rem;
    text-align: center;
  }

  .thumbnail-card:hover .overlay,
  .thumbnail-card:focus-visible .overlay {
    opacity: 1;
  }

  .video-title {
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .lightbox {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .lightbox.active {
    opacity: 1;
    pointer-events: auto;
  }

  .lightbox-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.9);
    backdrop-filter: blur(4px);
  }

  .lightbox-content {
    position: relative;
    width: 90%;
    max-width: 1000px;
    z-index: 1001;
  }

  .video-wrapper {
    position: relative;
    padding-top: 56.25%;
    background: #000;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .video-wrapper video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    outline: none;
  }

  .close-btn {
    position: absolute;
    top: -2.5rem;
    right: 0;
    background: none;
    border: none;
    color: #fff;
    font-family: var(--font-mono);
    font-size: 2rem;
    line-height: 1;
    cursor: pointer;
    opacity: 0.7;
    transition: opacity 0.2s;
  }

  .close-btn:hover {
    opacity: 1;
  }
</style>
